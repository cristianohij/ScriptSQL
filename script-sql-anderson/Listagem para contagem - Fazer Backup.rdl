<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="tanby_matriz">
      <DataSourceReference>tanby_matriz</DataSourceReference>
      <rd:DataSourceID>7ace1580-4390-4aa7-a0a8-8fe43368c911</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="ST">
          <DataField>ST</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COD">
          <DataField>COD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCRIÇÃO">
          <DataField>DESCRIÇÃO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MARCA">
          <DataField>MARCA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOC_1">
          <DataField>LOC 1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UN1">
          <DataField>UN1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QTD">
          <DataField>QTD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>tanby_matriz</DataSourceName>
        <CommandText>SELECT A.PROSTATUS AS 'ST', 
RTRIM(LTRIM(A.PROCOD)) AS 'COD', 
RTRIM(A.PRODES) AS DESCRIÇÃO, 
CASE WHEN len(A.MARCOD) = 4 
		THEN rtrim(A.MARCOD) + ' - ' + rtrim(A.MARNOM) 
		ELSE RIGHT(('00' + ltrim(str(A.MARCOD))), 3) + ' - ' + rtrim(A.MARNOM) END AS 'MARCA', 
A.PROLOCFIS AS 'LOC 1',
CASE WHEN PROUM1QTD &gt; 1 THEN RTRIM(LTRIM(PROUM1))+' '+ 
	RTRIM(CONVERT(DECIMAL,PROUM1QTD,0))+ '' + CASE WHEN PROUMV = '' THEN PROUM1 ELSE PROUMV END ELSE 
	RTRIM(CONVERT(DECIMAL,PROUM1QTD,0))+ '' + CASE WHEN PROUMV = '' THEN PROUM1 ELSE PROUMV END END AS 'UN1',
'' AS 'QTD'

FROM TBS010 AS A (nolock) INNER JOIN
                 TBS032 AS B (nolock) ON A.PROCOD = B.PROCOD
				 
WHERE (A.PROLOCFIS LIKE(CASE WHEN @Loc = '' THEN '% %' ELSE RTRIM(UPPER(@Loc)) + '%'END) ) AND (B.ESTLOC = '1') 
AND A.PROSTATUS IN(CASE WHEN @Sta = 'T' THEN A.PROSTATUS ELSE UPPER(@Sta) END )
AND A.MARNOM LIKE (CASE WHEN @Marnom = '' THEN '% %' ELSE RTRIM(UPPER(@Marnom))+ '%' END ) 
AND (B.ESTQTDATU-B.ESTQTDRES &gt; case when @somenteComSaldo='N' then -999999 else 0 end )
AND A.PROCOD LIKE (CASE WHEN @Cod = '' THEN '% %' ELSE RTRIM(@Cod)+'%' END)
AND A.PRODES LIKE (CASE WHEN @Descr = '' THEN '% %' ELSE RTRIM(UPPER(@Descr)) + '%' END)


ORDER BY 'LOC 1'
</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Loc">
            <Value>=Parameters!Loc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Sta">
            <Value>=Parameters!Sta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Marnom">
            <Value>=Parameters!Marnom.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@somenteComSaldo">
            <Value>=Parameters!somenteComSaldo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Cod">
            <Value>=Parameters!Cod.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Descr">
            <Value>=Parameters!Descr.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
  </DataSets>
